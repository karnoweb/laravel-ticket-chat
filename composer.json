{
    "name": "karnoweb/laravel-ticket-chat",
    "description": "A comprehensive ticketing and messaging system for Laravel applications",
    "keywords": ["laravel", "ticket", "chat", "support", "helpdesk", "messaging"],
    "license": "MIT",
    "authors": [
        {
            "name": "Karnoweb",
            "email": "info@karnoweb.ir"
        }
    ],
    "version": "13.1.0",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/broadcasting": "^13.0",
        "illuminate/notifications": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/phpstan": "^1.10|^2.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Karnoweb\\TicketChat\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Karnoweb\\TicketChat\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Karnoweb\\TicketChat\\TicketChatServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
